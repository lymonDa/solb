# SOLB Website - Production Hostinger .htaccess Configuration
RewriteEngine On

# 1. Enforce HTTPS
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 2. Custom 404 handler
ErrorDocument 404 /404.html

# 3. Security headers & options
Options -Indexes
AddDefaultCharset UTF-8

<IfModule mod_headers.c>
  # 1-year cache for fingerprinted static assets and images
  <FilesMatch "\.(js|css|woff2|avif|webp|jpg|jpeg|png|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Revalidate HTML immediately on new releases
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # Prevent MIME type sniffing
  Header set X-Content-Type-Options "nosniff"

  # Referrer policy
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
